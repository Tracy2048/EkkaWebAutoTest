<UserControl x:Class="EkkaWebAutoTest.UI.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EkkaWebAutoTest.UI.Views"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Thông tin dự án -->
            <RowDefinition Height="Auto"/>
            <!-- Người thực hiện -->
            <RowDefinition Height="400"/>
            <!-- Bảng + Biểu đồ -->
            <RowDefinition Height="Auto"/>
            <!-- Các nút bên dưới bảng -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.ColumnSpan="2" Text="BÁO CÁO KẾT QUẢ KIỂM THỬ" 
                   FontSize="32" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,10"/>

        <!-- Thông tin dự án và môi trường -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
            <TextBlock Text="📁 Tên dự án: " FontSize="16"/>
            <TextBlock Text="Ecommerce" FontWeight="Bold" FontSize="16" Margin="5,0"/>
            <TextBlock Text="    🖥️ Môi trường:" FontSize="16" Margin="20,0"/>
            <TextBlock x:Name="EnvironmentText" Text="Windows 10, Chrome" FontWeight="Bold" FontSize="16"/>
        </StackPanel>

        <!-- Người thực hiện & ngày -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
            <TextBlock Text="👤 Người thực hiện: " FontSize="16"/>
            <TextBlock Text="HangTT" FontWeight="Bold" FontSize="16" Margin="5,0"/>
            <TextBlock Text="    📅 Ngày thực hiện: " FontSize="16" Margin="20,0"/>
            <TextBlock x:Name="ExecutionDateText" FontWeight="Bold" FontSize="16"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="FunctionReportGrid" Grid.Row="3" Grid.Column="0" FontSize="16" RowHeight="35"
                  AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,10,10,0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FunctionName}" Value="Tổng">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Background" Value="#FFEFEFEF"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Chức năng" Binding="{Binding FunctionName}" Width="2*"/>
                <DataGridTextColumn Header="Passed" Binding="{Binding Passed}" Width="*"/>
                <DataGridTextColumn Header="Failed" Binding="{Binding Failed}" Width="*"/>
                <DataGridTextColumn Header="Tổng" Binding="{Binding Total}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Pie Chart -->
        <Viewbox Grid.Row="3" Grid.Column="1" Margin="10,10,0,0" Stretch="Uniform">
            <lvc:PieChart x:Name="PassFailPieChart"
                          LegendLocation="Bottom"
                          InnerRadius="0"
                          HoverPushOut="5"
                          Width="200" Height="150"/>
        </Viewbox>

        <!-- Các nút bên dưới bảng -->
        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
            <Button  Tag="{Binding}" Click="RunAllTestCases_Click"
                Width="120" Height="35"
                Padding="10,5" Margin="5"
                Background="#2196F3" Foreground="White"
                FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="▶" FontSize="14" Margin="0,0,5,0"/>
                    <TextBlock Text="Kiểm thử" FontSize="16"/>
                </StackPanel>
            </Button>
            <!--<Button  Tag="{Binding}"
                Width="120" Height="35"
                Padding="10,5" Margin="5"
                Background="#2196F3" Foreground="White"
                FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🧾" FontSize="14" Margin="0,0,5,0"/>
                    <TextBlock Text="Xuất PDF" FontSize="16"/>
                </StackPanel>
            </Button>-->
        </StackPanel>
    </Grid>
</UserControl>
